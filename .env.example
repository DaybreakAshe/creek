# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Google OAuth (在 https://console.cloud.google.com/ 获取)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# MongoDB
MONGODB_URI=mongodb://localhost:27017/your-database

# Admin（Google OAuth 登录后的 User ID，仅该 ID 可访问 /admin）
ADMIN_USER_ID=116251994689422103495

# Sirv 文件存储（在 Sirv 账户 API 设置页创建 Client）
SIRV_CLIENT_ID=your_sirv_client_id
SIRV_CLIENT_SECRET=your_sirv_client_secret
# Sirv CDN 域名，如 your-account.sirv.com（上传后公开访问地址的前缀）
SIRV_CDN_URL=your-account.sirv.com

# Google Gemini（AI 聊天，在 https://aistudio.google.com/apikey 获取）
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# 可选：默认模型 id（须为 Google ListModels 返回且支持 generateContent 的 id）
# GEMINI_MODEL=gemini-2.5-flash
# 可选：在官方列表基础上再限制可切换模型，逗号分隔 id
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash
# 可选：官方模型列表缓存时间（秒），默认 3600
# GEMINI_MODELS_CACHE_SECONDS=3600
